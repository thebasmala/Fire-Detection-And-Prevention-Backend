# Paste/update these in backend .env for DIFFERENT-NETWORK mode.

DEBUG=False
HOST=0.0.0.0
PORT=8000

# Public URL that clients/Pi can reach.
PUBLIC_API_BASE_URL=https://REPLACE_PUBLIC_BACKEND_URL

FIRE_FRAME_UPLOAD_API_KEY=REPLACE_WITH_YOUR_KEY

# CORS for production frontend domains
CORS_ORIGINS=https://REPLACE_FRONTEND_DOMAIN,https://REPLACE_SECOND_DOMAIN

# Remote/public MQTT broker reachable by backend
MQTT_BROKER_HOST=REPLACE_PUBLIC_MQTT_HOST
MQTT_BROKER_PORT=1883
MQTT_USERNAME=REPLACE_MQTT_USER
MQTT_PASSWORD=REPLACE_MQTT_PASS
