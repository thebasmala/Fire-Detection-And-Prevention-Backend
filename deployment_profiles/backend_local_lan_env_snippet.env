# Paste/update these in backend .env for SAME-LAN mode.

DEBUG=True
HOST=0.0.0.0
PORT=8000

# Public base URL used in links (can stay LAN for local testing).
PUBLIC_API_BASE_URL=http://Basmala.local:8000
# PUBLIC_API_BASE_URL=http://192.168.100.4:8000

FIRE_FRAME_UPLOAD_API_KEY=REPLACE_WITH_YOUR_KEY

# Local LAN Pi MQTT broker (if backend is expected to connect locally)
MQTT_BROKER_HOST=raspberrypi.local
MQTT_BROKER_PORT=1883
