# Copy to mqtt.env on the Pi and load before starting smart_fire_main.py:
#   cp mqtt.env.example mqtt.env
#   chmod 600 mqtt.env
#
# Or add to systemd: EnvironmentFile=/home/pi/smart_fire_system/integration/smart_fire_system/mqtt.env

# HiveMQ Cloud (must match FastAPI backend .env MQTT settings)
SMART_FIRE_MQTT_HOST=0ea78527b00b4714991d8b2021233019.s1.eu.hivemq.cloud
SMART_FIRE_MQTT_PORT=8883
SMART_FIRE_MQTT_USER=basmala
SMART_FIRE_MQTT_PASS=Yellow#0330

# HTTP frame upload — FastAPI port 8000 (NOT MJPEG /video_feed / Remote.it stream URL)
# Must match backend FIRE_FRAME_UPLOAD_API_KEY
SMART_FIRE_BACKEND_URL=http://192.168.100.4:8000
SMART_FIRE_FRAME_KEY=f7k2m9x4p1q8w3n6j5r0t2y8u1v4z9s

# --- Local Mosquitto on Pi (comment HiveMQ lines above, use these instead) ---
