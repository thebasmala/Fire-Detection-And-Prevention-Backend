[Unit]
Description=Smart Fire Runtime (AI + MJPEG stream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smart_fire_system/integration
# Optional: MQTT + backend URLs (copy smart_fire_system/mqtt.env.example -> mqtt.env on the Pi)
EnvironmentFile=-/home/pi/smart_fire_system/integration/smart_fire_system/mqtt.env
ExecStart=/usr/bin/python3 /home/pi/smart_fire_system/integration/smart_fire_main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
